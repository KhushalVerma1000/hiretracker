# Neon: Dashboard > Connect. Use the POOLED string for DATABASE_URL and the DIRECT string for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Resend: API key with "Sending access"; RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="JopUP <hello@yourdomain.com>"
LEAD_NOTIFY_TO="you@yourdomain.com"
# Exact origin of the live site (no trailing slash). Requests from other origins are rejected.
SITE_ORIGIN="https://yourdomain.com"
BRAND_NAME="JopUP"
# Any long random string (openssl rand -hex 32).
IP_HASH_SALT="change-me"
